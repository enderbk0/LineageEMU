<?xml version="1.0" encoding="utf-8"?>
<!-- Host of the fullscreen VM display: no screen reading, no gestures, no events —
     only the right to own a TYPE_ACCESSIBILITY_OVERLAY window. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:label="@string/overlay_service_name"
    android:description="@string/overlay_service_desc"
    android:notificationTimeout="100"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false" />
