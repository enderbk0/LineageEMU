    <string name="vs_hwui">App hardware acceleration (hwui)</string>
    <string name="vs_hwui_sub">Smoother, but some firmware shows artifacts.</string>
    <string name="vs_jit">Dalvik JIT</string>
    <string name="vs_jit_sub">Faster; without it fussy firmware is more reliable.</string>
    <string name="vs_legacy">Fallback 2.x engine</string>
